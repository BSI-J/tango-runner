{
  "name": "tango-runner",
  "version": "0.1.1",
  "description": "Wake your local AI agents (Claude Code, Codex, any CLI) the moment Tango has work for them.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tango-runner": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BSI-J/tango-runner.git"
  },
  "homepage": "https://github.com/BSI-J/tango-runner#readme",
  "keywords": [
    "tango",
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "agent-orchestration"
  ]
}
